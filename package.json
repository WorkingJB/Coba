  },
  "devDependencies": {
    "@playwright/test": "1.63.0", "@types/node": "^24.0.0", "@types/pg": "8.23.1",
    "@types/react": "19.3.0", "@types/react-dom": "19.3.0", "tsx": "4.23.15", "typescript": "7.0.2", "vite": "8.3.2"
  }
